{
  "name": "courses-played",
  "private": true,
  "version": "1.0.0",
  "description": "Track golf courses you've played",
  "main": "server/index.js",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "nodemon server",
    "server": "node server",
    "build": "npm run build --workspace=client",
    "start": "npm run build && npm run server",
    "test": "npm-run-all test:server test:client",
    "test:server": "vitest run --config vitest.config.js",
    "test:client": "npm run test --workspace=client",
    "knex": "knex --knexfile ./server/db/knexfile.js",
    "migrate": "npm run knex -- migrate:latest",
    "seed": "npm run knex -- seed:run",
    "eval:rounds": "node server/evals/runRounds.js",
    "eval:scorecards": "node server/evals/runScorecards.js",
    "eval:screening": "node server/evals/runScreening.js",
    "import:par": "node server/db/importCoursePar.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^6.2.9",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sqlite3@5.1.7": true
  }
}
