API_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
FIREBASE_PROJECT_ID=courses-played

# Log a round in plain English (POST /api/v1/rounds/parse) and read scorecard photos.
# Set ONE of these; without either the endpoints return 503 and the rest of the app works.
# OpenRouter is used when its key is set, otherwise Anthropic directly.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# MODEL_PROVIDER=openrouter        force one when both keys are set (openrouter or anthropic)
# ROUND_PARSER_MODEL=anthropic/claude-haiku-4.5      (Anthropic direct: claude-haiku-4-5-20251001)
# Scorecard photos use a vision model; handwriting is harder than typed text.
# SCORECARD_PARSER_MODEL=anthropic/claude-sonnet-5   (Anthropic direct: claude-sonnet-5)
# CHAT_MODEL=anthropic/claude-haiku-4.5               (Anthropic direct: claude-haiku-4-5-20251001)

# Demo mode: with NO key above, DEMO_MODE=true answers from canned rules so the flow can be
# shown without a model. Text is read by simple rules; a photo always returns the same
# sample card. Responses are marked demo and the app says so. A real key overrides it.
# DEMO_MODE=true

# Jev (TypeSafe) screens typed round text before the model sees it. Leave blank to skip
# the screen. If it IS set and Jev is down, rounds are refused rather than left unscreened.
JEV_API_KEY=
# JEV_MODEL=jev-1.13.0

# Optional Langfuse tracing of those model calls. Leave blank to switch it off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
